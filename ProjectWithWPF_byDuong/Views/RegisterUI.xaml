<UserControl x:Class="ProjectWithWPF_byDuong.Views.RegisterUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="500" MinHeight="600" Width="800" Height="650"
        Background="{StaticResource BgDark}">

    <Grid>
        <Border Style="{StaticResource AuthCardStyle}">
            <StackPanel>

                <TextBlock Text="Tạo tài khoản mới"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource AuthColor}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Bắt đầu quản lý tài chính của bạn"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="Họ và tên" FontWeight="SemiBold"/>
                <TextBox x:Name="txtFullName"
                         Style="{StaticResource InputBoxStyle}"/>

                <TextBlock Text="Email" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEmail"
                         Style="{StaticResource InputBoxStyle}"/>

                <TextBlock Text="Mật khẩu" FontWeight="SemiBold"/>
                <PasswordBox x:Name="txtPassword"
                             Style="{StaticResource PasswordBoxStyle}"/>

                <Button Content="Đăng ký"
                        Style="{StaticResource BtnPrimaryAuth}"
                        Margin="0,10,0,20"
                        Click="DangKy_Click"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Đã có tài khoản? "
                               Foreground="{StaticResource TextMuted}"/>

                    <TextBlock Text="Đăng nhập ngay"
                               Foreground="{StaticResource AuthColor}"
                               FontWeight="Bold"
                               Cursor="Hand"
                               MouseDown="GoLogin_Click"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Success Notification -->
        <Border x:Name="successNotification"
                Background="#4CAF50"
                CornerRadius="8"
                Padding="20,15"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,30,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" 
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>
                <TextBlock x:Name="txtSuccessMessage"
                           Text="Đăng ký thành công!"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>