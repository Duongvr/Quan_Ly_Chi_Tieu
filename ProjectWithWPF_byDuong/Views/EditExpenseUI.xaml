<Window x:Class="ProjectWithWPF_byDuong.EditExpenseUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa chi tiêu"
        MinWidth="800"
        MinHeight="600"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Border Style="{StaticResource MainContainerStyle}">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="400">

            <StackPanel>

                <!-- BACK -->
                <Button x:Name="btnBack"
                        Style="{StaticResource BtnBackStyle}"
                        Click="BtnBack_Click"/>


                <!-- HEADER -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,30">

                    <Border Background="{StaticResource ExpenseColor}"
                            Width="60"
                            Height="60"
                            CornerRadius="15"
                            Margin="0,0,0,15">

                        <TextBlock Text="$"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <TextBlock Text="Sửa chi tiêu"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource ExpenseColor}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Cập nhật thông tin chi tiêu của bạn"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>

                </StackPanel>


                <!-- AMOUNT -->
                <TextBlock Text="💲 Số tiền"
                           Foreground="{StaticResource TextMuted}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtAmount"
                         Style="{StaticResource InputBoxStyle}"/>


                <!-- CATEGORY -->
                <TextBlock Text="🏷 Danh mục"
                           Foreground="{StaticResource TextMuted}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <!-- Replace existing cbCategory element with this if you want a template -->
                <ComboBox x:Name="cbCategory"
                    Style="{StaticResource CenterComboBoxStyle}"
                    SelectedIndex="0">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CategoryName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>


                <!-- NOTE -->
                <TextBlock Text="📄 Ghi chú"
                           Foreground="{StaticResource TextMuted}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtNote"
                         Style="{StaticResource InputBoxStyle}"
                         Height="80"
                         TextWrapping="Wrap"/>


                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Cập nhật"
                            Style="{StaticResource BtnPrimaryExpense}"
                            Height="50"
                            Width="70"
                            Margin="0,0,10,0"
                            Click="BtnUpdate_Click"/>

                    <Button Content="Hủy"
                            Style="{StaticResource BtnCancel}"
                            Height="50"
                            Width="70"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            Click="BtnCancel_Click"/>
                </StackPanel>

            </StackPanel>

        </Grid>
    </Border>
</Window>
