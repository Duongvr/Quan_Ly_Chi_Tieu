<UserControl x:Class="ProjectWithWPF_byDuong.DashboardUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="800"
        MinHeight="600"
        Background="#2B2B2B">

    <UserControl.Resources>

        <!-- CARD STYLE -->
        <Style x:Key="ActionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="MinHeight" Value="180"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="15"
                                      ShadowDepth="2"
                                      Opacity="0.15"/>
                </Setter.Value>
            </Setter>

            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>

                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#000000"
                                              BlurRadius="25"
                                              ShadowDepth="5"
                                              Opacity="0.25"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  BorderThickness="0">

        <!-- MAIN CONTAINER -->
        <Border Background="#F9FAFB"
                CornerRadius="25"
                Margin="20"
                Padding="30"
                MaxWidth="1000">

            <Border.Effect>
                <DropShadowEffect Color="#000000"
                                  BlurRadius="20"
                                  ShadowDepth="3"
                                  Opacity="0.1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116*"/>
                        <ColumnDefinition Width="45*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.ColumnSpan="2">
                        <TextBlock FontSize="26" FontWeight="Bold">
                            <Run Text="Quản lý " Foreground="#9333EA"/>
                            <Run Text="chi tiêu" Foreground="#E11D48"/>
                        </TextBlock>

                        <TextBlock Text="Chào mừng bạn trở lại!"
                                   Foreground="#6B7280"
                                   FontSize="14"
                                   Margin="0,5,0,0"/>

                        <TextBlock x:Name="txtWelcomeUser"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- LOGOUT BUTTON -->
                    <Button Grid.Column="1"
                            Content="Đăng xuất"
                            Padding="5,8"
                            Height="40"
                            Background="#EF4444"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BtnLogout_Click"
                            Style="{StaticResource BtnDanger}" Margin="132,4,31,17" RenderTransformOrigin="0.317,0.57"/>
                </Grid>

                <!-- BALANCE CARD -->
                <Border Grid.Row="1"
                        CornerRadius="18"
                        Margin="0,0,0,25"
                        Padding="25">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A855F7" Offset="0"/>
                            <GradientStop Color="#EC4899" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <TextBlock Text="Số dư hiện tại"
                                   Foreground="White"
                                   FontSize="15"/>

                        <TextBlock x:Name="txtBalance"
                                   Text="0 đ"
                                   Foreground="White"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   Margin="0,10,0,20"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#40FFFFFF"
                                    CornerRadius="12"
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Thu nhập" Foreground="White"/>
                                    <TextBlock x:Name="txtIncome"
                                               Text="+0 đ"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="#40FFFFFF"
                                    CornerRadius="12"
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="Chi tiêu" Foreground="White"/>
                                    <TextBlock x:Name="txtExpense"
                                               Text="-0 đ"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ACTION CARDS -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- EXPENSE -->
                    <Border Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource ActionCardStyle}"
                            MouseLeftButtonUp="OpenExpense">

                        <StackPanel VerticalAlignment="Center">
                            <Border Background="#FEE2E2"
                                    Width="60"
                                    Height="60"
                                    CornerRadius="12"
                                    Margin="0,0,0,15"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="💸" FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Quản lý chi tiêu"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Theo dõi các khoản chi"
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- STAT -->
                    <Border Grid.Row="0" Grid.Column="2"
                            Style="{StaticResource ActionCardStyle}"
                            MouseLeftButtonUp="OpenStatistic">
                        <StackPanel VerticalAlignment="Center">
                            <Border Background="#E0E7FF"
                                    Width="60" Height="60"
                                    CornerRadius="12"
                                    Margin="0,0,0,15"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="📊" FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Xem thống kê"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Phân tích tài chính"
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- INCOME -->
                    <Border Grid.Row="2" Grid.Column="0"
                            Style="{StaticResource ActionCardStyle}"
                            MouseLeftButtonUp="OpenIncome">
                        <StackPanel VerticalAlignment="Center">
                            <Border Background="#D1FAE5"
                                    Width="60" Height="60"
                                    CornerRadius="12"
                                    Margin="0,0,0,15"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="💰" FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Quản lý thu nhập"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Theo dõi các khoản thu"
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- REPORT -->
                    <Border Grid.Row="2" Grid.Column="2"
                            Style="{StaticResource ActionCardStyle}"
                            MouseLeftButtonUp="OpenReport">
                        <StackPanel VerticalAlignment="Center">
                            <Border Background="#FCE7F3"
                                    Width="60" Height="60"
                                    CornerRadius="12"
                                    Margin="0,0,0,15"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="📄" FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Xuất báo cáo"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Tạo báo cáo chi tiết"
                                       FontSize="13"
                                       Foreground="#9CA3AF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>

            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>