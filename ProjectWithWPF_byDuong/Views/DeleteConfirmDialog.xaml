<Window x:Class="ProjectWithWPF_byDuong.Views.DeleteConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận xóa"
        Height="250"
        Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Border Background="{StaticResource BgCard}"
            CornerRadius="15"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Margin="10">

        <Border.Effect>
            <DropShadowEffect Color="Black"
                              BlurRadius="20"
                              Opacity="0.1"
                              ShadowDepth="5"/>
        </Border.Effect>

        <Border Padding="30">

            <Grid Margin="0,-11,0,0">

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center" Height="190">

                    <!-- Icon -->
                    <Border Background="#FEE2E2"
                            Width="47"
                            Height="45"
                            CornerRadius="25"
                            Margin="0,0,0,15">

                        <TextBlock Text="!"
                                   Foreground="{StaticResource DangerColor}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <!-- Title -->
                    <TextBlock Text="Bạn có chắc chắn muốn xóa?"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextMain}"
                               Margin="0,0,0,5"/>


                    <!-- Description -->
                    <TextBlock Text="Dữ liệu này sẽ không thể khôi phục."
                               FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>


                    <!-- Buttons -->
                    <Grid Width="250">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Hủy"
                                Style="{StaticResource BtnCancel}"
                                Click="BtnCancel_Click"/>

                        <Button Grid.Column="1"
                                Content="Xóa"
                                Style="{StaticResource BtnDanger}"
                                Click="BtnDelete_Click" Grid.ColumnSpan="2" Margin="14,0,0,10"/>

                    </Grid>

                </StackPanel>

            </Grid>

        </Border>

    </Border>

</Window>