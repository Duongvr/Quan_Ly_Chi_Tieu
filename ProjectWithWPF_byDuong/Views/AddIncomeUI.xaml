<Window x:Class="ProjectWithWPF_byDuong.AddIncomeUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm thu nhập mới"
        MinWidth="800"
        MinHeight="600"
        Width="900"
        Height="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Border Style="{StaticResource MainContainerStyle}">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Width="400">

            <StackPanel>

                <Button x:Name="btnBack"
                        Style="{StaticResource BtnBackStyle}"
                        Click="BtnBack_Click"/>

                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,30">

                    <Border Background="{StaticResource IncomeColor}"
                            Width="60"
                            Height="60"
                            CornerRadius="15"
                            Margin="0,0,0,15">

                        <TextBlock Text="$"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Thêm thu nhập mới"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource IncomeColor}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Nhập thông tin thu nhập của bạn"
                               Foreground="{StaticResource TextMuted}"
                               Margin="0,5,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>


                <TextBlock Text="💲 Số tiền"
                           Foreground="{StaticResource TextMuted}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtAmount"
                         Style="{StaticResource InputBoxStyle}"
                         Text="Nhập số tiền..."
                         GotFocus="TxtAmount_GotFocus"
                         LostFocus="TxtAmount_LostFocus"/>


                <TextBlock Text="🏷 Danh mục"
                           Foreground="{StaticResource TextMuted}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <!-- Replace existing cbCategory element with this if you want a template -->
                <ComboBox x:Name="cbCategory"
                    Style="{StaticResource CenterComboBoxStyle}"
                    SelectedIndex="0">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CategoryName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>


                <TextBlock Text="📄 Ghi chú"
                           Foreground="{StaticResource TextMuted}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtNote"
                         Style="{StaticResource InputBoxStyle}"
                         Height="80"
                         TextWrapping="Wrap"
                         Text="Nhập ghi chú..."
                         GotFocus="TxtNote_GotFocus"
                         LostFocus="TxtNote_LostFocus"/>


                <Button Content="Thêm thu nhập"
                        Style="{StaticResource BtnPrimaryIncome}"
                        Height="Auto"
                        MinHeight="55"
                        Padding="0,15"
                        FontSize="18"
                        FontWeight="Bold"
                        Margin="0,15,0,0"
                        Click="BtnAddIncome_Click"/>

            </StackPanel>
        </Grid>
    </Border>
</Window>