<UserControl x:Class="ProjectWithWPF_byDuong.Views.ExportReportUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="800" MinHeight="600"
        Background="{StaticResource BgDark}">

    <Border Style="{StaticResource MainContainerStyle}" Padding="30">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <Button x:Name="btnBack" Style="{StaticResource BtnBackStyle}" HorizontalAlignment="Left" Margin="0,0,0,15" Click="BtnBack_Click"/>
                <TextBlock Text="Lịch sử giao dịch &amp; Báo cáo" FontSize="28" FontWeight="Bold" Foreground="#0284C7"/>
                <TextBlock Text="Xem chi tiết và xuất dữ liệu các khoản thu chi của bạn" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Lọc dữ liệu" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Từ ngày:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                            <DatePicker x:Name="dpStartDate" Width="150"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Đến ngày:" Foreground="{StaticResource TextMuted}" Margin="0,0,0,5"/>
                            <DatePicker x:Name="dpEndDate" Width="150"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnViewHistory" Content="Xem lịch sử" Width="120" Height="35" Margin="0,0,10,0" Background="#0284C7" Foreground="White" BorderThickness="0" Click="BtnViewHistory_Click"/>
                        <Button x:Name="btnExportReport" Content="Xuất báo cáo" Width="120" Height="35" Background="#10B981" Foreground="White" BorderThickness="0" Click="BtnExportReport_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh sách giao dịch" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

                    <DataGrid Grid.Row="1" x:Name="dgHistory" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E7EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="100"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="150"/>
                            <DataGridTextColumn Header="Số tiền" Binding="{Binding Amount, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>