<UserControl x:Class="ProjectWithWPF_byDuong.Views.ForgotPasswordUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="500" MinHeight="450"
        Width="800" Height="500"
        Background="{StaticResource BgDark}">

    <Border Style="{StaticResource AuthCardStyle}">
        <StackPanel>

            <!-- Back -->
            <TextBlock x:Name="btnBackLogin"
                       Text="← Quay lại đăng nhập"
                       Foreground="{StaticResource TextMuted}"
                       FontWeight="SemiBold"
                       Cursor="Hand"
                       Margin="0,0,0,20"
                       MouseDown="BtnBackLogin_MouseDown"/>

            <!-- Title -->
            <TextBlock Text="Khôi phục mật khẩu"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource AuthColor}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Nhập email đã đăng ký để đặt lại mật khẩu"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Email -->
            <TextBlock Text="Email của bạn"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="txtEmail"
                     Style="{StaticResource InputBoxStyle}"
                     Text="Nhập email đã đăng ký..."
                     GotFocus="TxtEmail_GotFocus"
                     LostFocus="TxtEmail_LostFocus"/>

            <!-- New password -->
            <TextBlock Text="Mật khẩu mới"
                       FontWeight="SemiBold"
                       Margin="0,10,0,5"/>

            <PasswordBox x:Name="txtNewPassword"
                         Style="{StaticResource InputBoxStyle}"/>

            <!-- Button -->
            <Button Content="Đặt lại mật khẩu"
                    Style="{StaticResource BtnPrimaryAuth}"
                    Margin="0,20,0,0"
                    Click="BtnResetPassword_Click"/>

        </StackPanel>
    </Border>

</UserControl>